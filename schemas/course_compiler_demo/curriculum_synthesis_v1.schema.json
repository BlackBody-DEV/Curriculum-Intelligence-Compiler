{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumSynthesisPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id", "course_id", "evidence_graph", "nodes", "conflicts",
    "coverage_gaps", "completeness", "canonical_authority"
  ],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "course_id": {"type": "string", "minLength": 1},
    "evidence_graph": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id", "node_type", "title", "inference_boundary",
          "evidence_claim_ids", "rationale", "confidence", "review_required"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "node_type": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "inference_boundary": {
            "enum": [
              "DIRECT_SOURCE_EVIDENCE", "MULTI_SOURCE_SYNTHESIS",
              "INFERRED_PREREQUISITE", "COURSE_PACK_REFERENCE", "UNSUPPORTED"
            ]
          },
          "evidence_claim_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_required": {"type": "boolean"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id", "conflict_class", "node_ids",
          "evidence_claim_ids", "resolution_state"
        ],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "conflict_class": {"type": "string", "minLength": 1},
          "node_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "resolution_state": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id", "gap_type", "scope_id", "rationale", "evidence_claim_ids"
        ],
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "gap_type": {"type": "string", "minLength": 1},
          "scope_id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_claim_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "completeness": {
      "enum": [
        "SOURCE_COMPLETE", "COURSE_PACK_COMPLETE", "SYNTHESIZED_WITH_GAPS",
        "INSUFFICIENT_EVIDENCE", "CONFLICT_BLOCKED"
      ]
    },
    "canonical_authority": {"const": false}
  }
}
