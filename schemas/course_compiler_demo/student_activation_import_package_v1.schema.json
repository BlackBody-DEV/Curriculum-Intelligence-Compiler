{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "student_activation_import_package_v1.schema.json",
  "title": "Student Activation Import Package V1",
  "description": "Non-executable, human-review-required import proposal for a separately authorized adaptive-platform activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "compiler_commit", "target", "identity_and_ownership", "capability_handshake", "transaction_contract", "retry_contract", "rollback_contract", "questions", "assessments", "safety", "package_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "minLength": 1},
    "compiler_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {"type": "object"},
    "identity_and_ownership": {"type": "object"},
    "capability_handshake": {"type": "object"},
    "transaction_contract": {"type": "object"},
    "retry_contract": {"type": "object"},
    "rollback_contract": {"type": "object"},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assessments": {"type": "array", "items": {"type": "object"}},
    "safety": {
      "type": "object",
      "required": ["noncanonical", "human_review_required", "database_write_authorized", "canonical_promotion_authorized", "adaptive_platform_write_authorized", "student_visibility_authorized", "live_beta_import_authorized"],
      "properties": {
        "noncanonical": {"const": true},
        "human_review_required": {"const": true},
        "database_write_authorized": {"const": false},
        "canonical_promotion_authorized": {"const": false},
        "adaptive_platform_write_authorized": {"const": false},
        "student_visibility_authorized": {"const": false},
        "live_beta_import_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
